# Copy to .env (gitignored). Only the chosen provider's key is required.
#
# Models under test are open-weight and served over the OpenAI-compatible wire
# format; these are open-weight-provider keys, not OpenAI keys.
TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# The judge (Phase 2) is configured independently of the harness provider and is
# the one component permitted a closed model. It must not be either model under
# test, and its labels are Cohen's-kappa-gated regardless of provenance.
JUDGE_API_KEY=
