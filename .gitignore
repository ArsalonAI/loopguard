# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
credentials.json

# ---------------------------------------------------------------------------
# LoopGuard run artifacts
#
# Traces are append-only JSONL per episode; a full 1200-episode matrix is large
# and regenerable from a committed config + manifest. Keep configs and locks in
# git, keep raw traces out.
# ---------------------------------------------------------------------------
runs/
traces/
*.jsonl
# The hand-labeled judge-calibration set IS tracked -- it is human labour, not
# regenerable output. Note: git has no inline comments, so this negation must
# stay on a line of its own or it silently stops matching.
!fixtures/**/*.jsonl
cache/
.cache/
outputs/
reports/*.html
reports/*.pdf

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
# TRACKED: uv.lock pins packages but not the interpreter, and reproducibility of
# the analysis environment is part of the deliverable (TRD 1).
!.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Node / dashboard
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
dist-ssr/
.vite/
build/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Infra / deploy
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
.aws-sam/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
